{
  "QueryLanguage": "JSONata",
  "StartAt": "Init pipeline",
  "States": {
    "Init pipeline": {
      "Type": "Task",
      "Resource": "arn:aws:lambda:${AWS_REGION}:${AWS_ACCOUNT_ID}:function:${STAGE}-pipeline_init:$LATEST",
      "Next": "Daily File Execution",
      "Retry": [
        {
          "ErrorEquals": [
            "States.Timeout",
            "Lambda.Unknown",
            "Lambda.AWSLambdaException"
          ],
          "BackoffRate": 3,
          "IntervalSeconds": 30,
          "MaxAttempts": 3,
          "Comment": "Timeout retry"
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Next": "Notify Failure",
          "Output": "{% { 'stage': 'pipeline_init', 'errorOutput': $states.errorOutput, 'jobs_key': '', 'bucket': $states.input.bucket, 'source': $states.input.source } %}"
        }
      ]
    },
    "Daily File Execution": {
      "Type": "Task",
      "Resource": "arn:aws:states:::states:startExecution.sync:2",
      "Arguments": {
        "StateMachineArn": "arn:aws:states:${AWS_REGION}:${AWS_ACCOUNT_ID}:stateMachine:nasa-ssh-pipeline-${STAGE}-daily_file-sm",
        "Input": {
          "jobs_key": "{% $states.input.jobs_key %}",
          "bucket": "{% $states.input.bucket %}",
          "source": "{% $states.input.source %}"
        }
      },
      "Output": "{% $states.input %}",
      "Next": "Xover 1 Execution",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Next": "Notify Failure",
          "Output": "{% { 'stage': 'daily_file', 'errorOutput': $states.errorOutput, 'jobs_key': $states.input.jobs_key, 'bucket': $states.input.bucket, 'source': $states.input.source } %}"
        }
      ]
    },
    "Xover 1 Execution": {
      "Type": "Task",
      "Resource": "arn:aws:states:::states:startExecution.sync:2",
      "Arguments": {
        "StateMachineArn": "arn:aws:states:${AWS_REGION}:${AWS_ACCOUNT_ID}:stateMachine:nasa-ssh-pipeline-${STAGE}-xover-sm",
        "Input": {
          "jobs_key": "{% $states.input.jobs_key %}",
          "bucket": "{% $states.input.bucket %}",
          "source": "{% $states.input.source %}",
          "df_version": "p1"
        }
      },
      "Output": "{% $states.input %}",
      "Next": "OER Execution",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Next": "Notify Failure",
          "Output": "{% { 'stage': 'xover', 'errorOutput': $states.errorOutput, 'jobs_key': $states.input.jobs_key, 'bucket': $states.input.bucket, 'source': $states.input.source } %}"
        }
      ]
    },
    "OER Execution": {
      "Type": "Task",
      "Resource": "arn:aws:states:::states:startExecution.sync:2",
      "Arguments": {
        "StateMachineArn": "arn:aws:states:${AWS_REGION}:${AWS_ACCOUNT_ID}:stateMachine:nasa-ssh-pipeline-${STAGE}-oer-sm",
        "Input": {
          "jobs_key": "{% $states.input.jobs_key %}",
          "bucket": "{% $states.input.bucket %}",
          "source": "{% $states.input.source %}",
          "df_version": "p1"
        }
      },
      "Output": "{% $states.input %}",
      "Next": "Xover 2 Execution",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Next": "Notify Failure",
          "Output": "{% { 'stage': 'oer', 'errorOutput': $states.errorOutput, 'jobs_key': $states.input.jobs_key, 'bucket': $states.input.bucket, 'source': $states.input.source } %}"
        }
      ]
    },
    "Xover 2 Execution": {
      "Type": "Task",
      "Resource": "arn:aws:states:::states:startExecution.sync:2",
      "Arguments": {
        "StateMachineArn": "arn:aws:states:${AWS_REGION}:${AWS_ACCOUNT_ID}:stateMachine:nasa-ssh-pipeline-${STAGE}-xover-sm",
        "Input": {
          "jobs_key": "{% $states.input.jobs_key %}",
          "bucket": "{% $states.input.bucket %}",
          "source": "{% $states.input.source %}",
          "df_version": "p2"
        }
      },
      "Output": "{% $states.input %}",
      "Next": "Bad Pass Execution",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Next": "Notify Failure",
          "Output": "{% { 'stage': 'xover', 'errorOutput': $states.errorOutput, 'jobs_key': $states.input.jobs_key, 'bucket': $states.input.bucket, 'source': $states.input.source } %}"
        }
      ]
    },
    "Bad Pass Execution": {
      "Type": "Task",
      "Resource": "arn:aws:states:::states:startExecution.sync:2",
      "Arguments": {
        "StateMachineArn": "arn:aws:states:${AWS_REGION}:${AWS_ACCOUNT_ID}:stateMachine:nasa-ssh-pipeline-${STAGE}-bad_pass-sm",
        "Input": {
          "jobs_key": "{% $states.input.jobs_key %}",
          "bucket": "{% $states.input.bucket %}",
          "source": "{% $states.input.source %}"
        }
      },
      "Output": "{% $states.input %}",
      "Next": "Finalizer Execution",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Next": "Notify Failure",
          "Output": "{% { 'stage': 'bad_pass', 'errorOutput': $states.errorOutput, 'jobs_key': $states.input.jobs_key, 'bucket': $states.input.bucket, 'source': $states.input.source } %}"
        }
      ]
    },
    "Finalizer Execution": {
      "Type": "Task",
      "Resource": "arn:aws:states:::states:startExecution.sync:2",
      "Arguments": {
        "StateMachineArn": "arn:aws:states:${AWS_REGION}:${AWS_ACCOUNT_ID}:stateMachine:nasa-ssh-pipeline-${STAGE}-finalizer-sm",
        "Input": {
          "jobs_key": "{% $states.input.jobs_key %}",
          "bucket": "{% $states.input.bucket %}",
          "source": "{% $states.input.source %}"
        }
      },
      "Output": {
        "jobs_key": "{% $states.input.jobs_key %}",
        "bucket": "{% $states.input.bucket %}",
        "source": "{% $states.input.source %}",
        "unify": "{% $states.input.unify %}"
      },
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Next": "Notify Failure",
          "Output": "{% { 'stage': 'finalizer', 'errorOutput': $states.errorOutput, 'jobs_key': $states.input.jobs_key, 'bucket': $states.input.bucket, 'source': $states.input.source } %}"
        }
      ],
      "End": true
    },
    "Notify Failure": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Arguments": {
        "FunctionName": "arn:aws:lambda:${AWS_REGION}:${AWS_ACCOUNT_ID}:function:${STAGE}-failure_handling:$LATEST",
        "Payload": "{% $states.input %}"
      },
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 5,
          "MaxAttempts": 2,
          "BackoffRate": 2
        }
      ],
      "Next": "Fail"
    },
    "Fail": {
      "Type": "Fail"
    }
  }
}

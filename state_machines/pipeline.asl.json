{
  "QueryLanguage": "JSONata",
  "StartAt": "Along Track Execution",
  "States": {
    "Along Track Execution": {
      "Type": "Task",
      "Resource": "arn:aws:states:::states:startExecution.sync:2",
      "Arguments": {
        "StateMachineArn": "arn:aws:states:${AWS_REGION}:${AWS_ACCOUNT_ID}:stateMachine:nasa-ssh-pipeline-${STAGE}-at_pipeline-sm",
        "Input": "{% $states.input %}"
      },
      "Next": "Has Jobs?",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Next": "Fail"
        }
      ]
    },
    "Has Jobs?": {
      "Type": "Choice",
      "Choices": [
        {
          "Next": "Publish Along Track",
          "Condition": "{% $states.input.Output.job_count > 0 %}"
        }
      ],
      "Default": "No Jobs Summary"
    },
    "No Jobs Summary": {
      "Type": "Pass",
      "Comment": "Fast exit: the along-track run found no dates to process. Skip publication and the SG pipeline; unwrap the execution result to the bare run identity Run Summary expects, then summarize (empty manifests reconcile to expected 0 / produced 0).",
      "Output": "{% $states.input.Output %}",
      "Next": "Run Summary"
    },
    "Publish Along Track": {
      "Type": "Task",
      "Comment": "Unconditional: every source publishes, and which line it publishes to is derived from its product_type rather than gated by config.",
      "Resource": "arn:aws:states:::states:startExecution.sync:2",
      "Arguments": {
        "StateMachineArn": "arn:aws:states:${AWS_REGION}:${AWS_ACCOUNT_ID}:stateMachine:nasa-ssh-pipeline-${STAGE}-publisher-sm",
        "Input": "{% $merge([$states.input.Output, { 'family': 'along_track' }]) %}"
      },
      "Output": "{% $states.input.Output %}",
      "Next": "Rewrite Manifest",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Next": "Notify Failure",
          "Output": "{% { 'stage': 'publisher_along_track', 'errorOutput': $states.errorOutput, 'jobs_key': $states.input.Output.jobs_key, 'bucket': $states.input.Output.bucket, 'source': $states.input.Output.source } %}"
        }
      ]
    },
    "Rewrite Manifest": {
      "Type": "Task",
      "Comment": "Rekey the along-track manifest onto the published product the gridded tier works on. Becomes a merge of several source manifests once the parent is product-keyed.",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Arguments": {
        "FunctionName": "arn:aws:lambda:${AWS_REGION}:${AWS_ACCOUNT_ID}:function:${STAGE}-rewrite_manifest:$LATEST",
        "Payload": "{% { 'jobs_key': $states.input.jobs_key, 'bucket': $states.input.bucket, 'published_product': $states.input.published_product } %}"
      },
      "Output": "{% $states.result.Payload %}",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 10,
          "MaxAttempts": 5,
          "BackoffRate": 2,
          "JitterStrategy": "FULL"
        }
      ],
      "Next": "SG Execution",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Next": "Notify Failure",
          "Output": "{% { 'stage': 'rewrite_manifest', 'errorOutput': $states.errorOutput, 'jobs_key': $states.input.jobs_key, 'bucket': $states.input.bucket, 'source': $states.input.source } %}"
        }
      ]
    },
    "SG Execution": {
      "Type": "Task",
      "Resource": "arn:aws:states:::states:startExecution.sync:2",
      "Arguments": {
        "StateMachineArn": "arn:aws:states:${AWS_REGION}:${AWS_ACCOUNT_ID}:stateMachine:nasa-ssh-pipeline-${STAGE}-sg_pipeline-sm",
        "Input": "{% $states.input %}"
      },
      "Output": "{% $states.input %}",
      "Next": "Run Summary",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Next": "Fail"
        }
      ]
    },
    "Run Summary": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Arguments": {
        "FunctionName": "arn:aws:lambda:${AWS_REGION}:${AWS_ACCOUNT_ID}:function:${STAGE}-run_summary:$LATEST",
        "Payload": "{% { 'jobs_key': $states.input.jobs_key, 'bucket': $states.input.bucket } %}"
      },
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 5,
          "MaxAttempts": 2,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Next": "Succeed"
        }
      ],
      "Next": "Succeed"
    },
    "Succeed": {
      "Type": "Succeed"
    },
    "Notify Failure": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Arguments": {
        "FunctionName": "arn:aws:lambda:${AWS_REGION}:${AWS_ACCOUNT_ID}:function:${STAGE}-failure_handling:$LATEST",
        "Payload": "{% $states.input %}"
      },
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 5,
          "MaxAttempts": 2,
          "BackoffRate": 2
        }
      ],
      "Next": "Fail"
    },
    "Fail": {
      "Type": "Fail"
    }
  }
}

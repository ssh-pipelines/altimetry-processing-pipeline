{
  "QueryLanguage": "JSONata",
  "StartAt": "Along Track Execution",
  "States": {
    "Along Track Execution": {
      "Type": "Task",
      "Resource": "arn:aws:states:::states:startExecution.sync:2",
      "Arguments": {
        "StateMachineArn": "arn:aws:states:${AWS_REGION}:${AWS_ACCOUNT_ID}:stateMachine:nasa-ssh-pipeline-${STAGE}-at_pipeline-sm",
        "Input": "{% $states.input %}"
      },
      "Next": "Has Jobs?",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Next": "Fail"
        }
      ]
    },
    "Has Jobs?": {
      "Type": "Choice",
      "Choices": [
        {
          "Next": "Need Unification?",
          "Condition": "{% $states.input.Output.job_count > 0 %}"
        }
      ],
      "Default": "No Jobs Summary"
    },
    "No Jobs Summary": {
      "Type": "Pass",
      "Comment": "Fast exit: the along-track run found no dates to process. Skip unification and the SG pipeline; unwrap the execution result to the bare run identity Run Summary expects, then summarize (empty manifests reconcile to expected 0 / produced 0).",
      "Output": "{% $states.input.Output %}",
      "Next": "Run Summary"
    },
    "Need Unification?": {
      "Type": "Choice",
      "Choices": [
        {
          "Next": "Unifier Execution",
          "Condition": "{% $states.input.Output.unify = true %}"
        }
      ],
      "Default": "SG Execution"
    },
    "Unifier Execution": {
      "Type": "Task",
      "Resource": "arn:aws:states:::states:startExecution.sync:2",
      "Arguments": {
        "StateMachineArn": "arn:aws:states:${AWS_REGION}:${AWS_ACCOUNT_ID}:stateMachine:nasa-ssh-pipeline-${STAGE}-unifier-sm",
        "Input": "{% $states.input.Output %}"
      },
      "Next": "SG Execution",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Next": "Notify Failure",
          "Output": "{% { 'stage': 'unifier', 'errorOutput': $states.errorOutput, 'jobs_key': $states.input.Output.jobs_key, 'bucket': $states.input.Output.bucket, 'source': $states.input.Output.source } %}"
        }
      ]
    },
    "SG Execution": {
      "Type": "Task",
      "Resource": "arn:aws:states:::states:startExecution.sync:2",
      "Arguments": {
        "StateMachineArn": "arn:aws:states:${AWS_REGION}:${AWS_ACCOUNT_ID}:stateMachine:nasa-ssh-pipeline-${STAGE}-sg_pipeline-sm",
        "Input": "{% $states.input.Output %}"
      },
      "Output": "{% $states.input.Output %}",
      "Next": "Run Summary",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Next": "Fail"
        }
      ]
    },
    "Run Summary": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Arguments": {
        "FunctionName": "arn:aws:lambda:${AWS_REGION}:${AWS_ACCOUNT_ID}:function:${STAGE}-run_summary:$LATEST",
        "Payload": "{% { 'jobs_key': $states.input.jobs_key, 'bucket': $states.input.bucket, 'source': $states.input.source } %}"
      },
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 5,
          "MaxAttempts": 2,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Next": "Succeed"
        }
      ],
      "Next": "Succeed"
    },
    "Succeed": {
      "Type": "Succeed"
    },
    "Notify Failure": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Arguments": {
        "FunctionName": "arn:aws:lambda:${AWS_REGION}:${AWS_ACCOUNT_ID}:function:${STAGE}-failure_handling:$LATEST",
        "Payload": "{% $states.input %}"
      },
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 5,
          "MaxAttempts": 2,
          "BackoffRate": 2
        }
      ],
      "Next": "Fail"
    },
    "Fail": {
      "Type": "Fail"
    }
  }
}
